<root>
  <config-params class-type="ConfigParams">
    <verticalExaggeration>1</verticalExaggeration>
    <debugInfoEnabled>false</debugInfoEnabled>
    <profilerEnabled>false</profilerEnabled>
    <content-version>106026</content-version>
  </config-params>
  <input-handler class-type="BasicInputHandler">
    <skip-points>2</skip-points>
    <!-- camera limitations on poles, globe spinning against North -->
    <poles-restriction>
      <enabled>false</enabled>
    </poles-restriction>
    <!-- necessary for webapp -->
    <gestures>
      <!-- right mouse button -->
      <secondaryDrag>
        <enabled>true</enabled>
      </secondaryDrag>
      <pan>
        <enabled>true</enabled>
      </pan>
      <rotation>
        <enabled>true</enabled>
      </rotation>
      <tilt>
        <enabled>true</enabled>
      </tilt>
      <pinch>
        <enabled>true</enabled>
      </pinch>
    </gestures>
  </input-handler>
  <navigator class-type="RealPACNavigator">
    <gps-sources>
      <!-- no multicast for webapp -->
      <source class-type="CloudHttpGpsSource">
        <url>https://datahub.flightpath3d.com/flightapi</url>
        <token>1QzinOJfhjgWI9Mx6tTtD9lgc2u2dUscRQtbdzQRKwTo90mp52AXDDtx738pfVNdB5xBl60zHHh588BVeaOUy6tHTohmROGqn8eh7597CZuAn58o80emtKCoZuBDJ6b8</token>
      </source>
    </gps-sources>
    <airport-info-url>$(SERVER)/$(DYNAMIC)/public/index.php?lang=$(LANG)&amp;_url=/flightinfo/getAirportInfo</airport-info-url>
    <history-url>$(SERVER)/fp3d_logs/flight-history.log</history-url>
    <reqInterval>2</reqInterval>
