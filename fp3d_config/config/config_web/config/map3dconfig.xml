          <name>Invalid</name>
          <serverPresentPhases>Invalid,NoData</serverPresentPhases>
          <limitations>
            <viewMenu>
              <view>
                <name>FreeMapRoaming</name>
                <enable>true</enable>
              </view>
              <view>
                <name>LeftWindow</name>
                <enable>false</enable>
              </view>
              <view>
                <name>Pilot</name>
                <enable>false</enable>
              </view>
              <view>
                <name>RightWindow</name>
                <enable>false</enable>
              </view>
              <view>
                <name>PlaneCentric</name>
                <enable>false</enable>
              </view>
            </viewMenu>
            <ui>
